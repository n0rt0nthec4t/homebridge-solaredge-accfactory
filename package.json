{
    "name": "homebridge-solaredge-accfactory",
    "displayName": "SolarEdge Accfactory",
    "type": "module",
    "version": "0.0.6",
    "description": "SolarEdge inverter support for Homebridge",
    "author": "n0rt0nthec4t",
    "license": "Apache-2.0",
    "homepage": "https://github.com/n0rt0nthec4t/homebridge-solaredge-accfactory/#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n0rt0nthec4t/homebridge-solaredge-accfactory.git"
    },
    "bugs": {
        "url": "https://github.com/n0rt0nthec4t/homebridge-solaredge-accfactory/issues"
    },
    "funding": "https://github.com/n0rt0nthec4t/homebridge-solaredge-accfactory?sponsor=1",
    "keywords": [
        "homekit",
        "homebridge-plugin",
        "homebridge",
        "apple home",
        "supports-hap",
        "solaredge",
        "energy",
        "solar"
    ],
    "main": "dist/index.js",
    "engines": {
        "node": "^22 || ^24 || ^26",
        "homebridge": "^1.11.4 || ^2.4.0"
    },
    "files": [
        "LICENSE",
        "dist/**/*",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "format": "prettier --write \"src/*.{js,mjs}\" \"test/**/*.{js,mjs}\" && eslint --fix \"src/*.{js,mjs}\" \"test/**/*.js\"",
        "lint": "eslint \"src/*.{js,mjs}\" \"test/**/*.js\" --max-warnings=20",
        "test": "npm run build && node --test test/*.test.js",
        "test:coverage": "npm run build && node --test --experimental-test-coverage test/*.test.js",
        "check": "npm run lint && npm test && npm run build",
        "build": "npm run clean && copyfiles -u 1 src/*.js dist && copyfiles -u 2 src/HomeKitDevice/HomeKitDevice.js dist && copyfiles -u 2 src/HomeKitHistory/HomeKitHistory.js dist",
        "prepublishOnly": "npm run format && npm run lint && npm test && npm run build"
    },
    "devDependencies": {
        "@homebridge/hap-nodejs": "^2.2.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.5.1",
        "@typescript-eslint/parser": "^8.70.0",
        "copyfiles": "^2.4.1",
        "eslint": "^10.10.0",
        "homebridge": "^1.11.4 || ^2.4.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3"
    }
}
